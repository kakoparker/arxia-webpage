# ─────────────────────────────────────────────────────────────────────────────
# Arxia webpage — environment variables.
# Copy this file to `.env.local` (gitignored) and fill in real values.
# In production (Vercel), set these in Project Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────────────────────

# Resend — contact form delivery (POST /api/contact)
# Get a key from https://resend.com — verify the arxia.com domain so RESEND_FROM
# can use an @arxia.com address.
RESEND_API_KEY=
RESEND_FROM="Arxia <contact@arxia.com>"
# Optional: comma-separated override. Defaults to carlos.parker@arxia.com,daniel.homorodean@arxia.com
# CONTACT_RECIPIENTS=

# Plausible — analytics
# Set to the apex domain registered on plausible.io (e.g. "arxia.com").
# Leave empty in dev/local to skip injecting the script.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
